{
  "name": "dsh-swarmdrop",
  "version": "0.1.0",
  "description": "Send files from your DeepSeek Harness agent straight to your phone, and reference what your phone sent back \u2014 no account, no public IP, end-to-end encrypted.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:client": "node scripts/dev-tsconfig.mjs && tsc --noEmit -p tsconfig.dev.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "~5.8.0"
  },
  "optionalDependencies": {
    "swarmdrop": "^0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-projection": "^0.0.1-rc.1",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swarm-apps/dsh-swarmdrop.git"
  },
  "homepage": "https://github.com/swarm-apps/dsh-swarmdrop#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "swarmdrop",
    "file-transfer",
    "p2p"
  ]
}
